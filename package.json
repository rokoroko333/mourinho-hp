{
  "name": "infinito-mourinho",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "screenshot": "node scripts/screenshot.mjs",
    "og": "node scripts/og.mjs",
    "images": "node scripts/images.mjs",
    "test": "node --test test/*.test.mjs",
    "dev": "npm run build && wrangler pages dev dist",
    "deploy": "npm run build && wrangler pages deploy dist",
    "feeds:dev": "wrangler dev --config workers/feeds/wrangler.toml --test-scheduled",
    "feeds:deploy": "wrangler deploy --config workers/feeds/wrangler.toml",
    "verify": "node scripts/verify.mjs",
    "health": "node scripts/health.mjs",
    "release": "node scripts/release.mjs",
    "usage": "node scripts/usage.mjs"
  },
  "devDependencies": {
    "wrangler": "^4.0.0"
  },
  "engines": {
    "node": ">=22"
  }
}
